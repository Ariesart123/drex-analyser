{
  "name": "drex-analyser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply drex-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply drex-db --remote",
    "build:vercel": "node scripts/check-vercel.mjs && vite build --config vite.config.ts",
    "deploy:full": "npm run build && wrangler deploy -c wrangler.full.toml",
    "schema:all": "cat migrations/*.sql > docs/schema-all.sql"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.6.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.27.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
